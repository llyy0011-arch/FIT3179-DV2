
{
  "$schema": "https://vega.github.io/schema/vega/v5.json",
  "description": "NDIS proportional symbol map, December 2022",
  "width": 750,
  "height": 460,
  "padding": 15,
  "autosize": "pad",
  "background": "white",

  "title": {
    "text": "NDIS Participation Across Australia",
    "subtitle": "Circle size represents published participant counts, December 2022",
    "anchor": "middle",
    "fontSize": 20,
    "subtitleFontSize": 13
  },

  "data": [
    {
      "name": "state_totals",
      "url": "Data/ndis_2026_clean.csv",
      "format": {
        "type": "csv",
        "parse": {
          "report_date": "string",
          "state": "string",
          "participants": "string"
        }
      },
      "transform": [
        {
          "type": "filter",
          "expr": "datum.report_date === '2022-12-31'"
        },
        {
          "type": "filter",
          "expr": "datum.participants != null && datum.participants !== '' && datum.participants !== '<11'"
        },
        {
          "type": "formula",
          "expr": "toNumber(datum.participants)",
          "as": "count"
        },
        {
          "type": "filter",
          "expr": "isValid(datum.count) && isFinite(datum.count)"
        },
        {
          "type": "aggregate",
          "groupby": ["state"],
          "fields": ["count"],
          "ops": ["sum"],
          "as": ["participants_total"]
        }
      ]
    },
    {
      "name": "boundaries",
      "url": "Data/state_2021.json",
      "format": {
        "type": "topojson",
        "feature": "LGA_2021_AUST_GDA94"
      },
      "transform": [
        {
          "type": "formula",
          "expr": "datum.properties.STE_NAME21",
          "as": "state"
        }
      ]
    },
    {
      "name": "symbols",
      "source": "boundaries",
      "transform": [
        {
          "type": "filter",
          "expr": "datum.state != null"
        },
        {
          "type": "lookup",
          "from": "state_totals",
          "key": "state",
          "fields": ["state"],
          "values": ["participants_total"],
          "as": ["participants_total"]
        },
        {
          "type": "filter",
          "expr": "isValid(datum.participants_total) && datum.participants_total > 0"
        },
        {
          "type": "formula",
          "expr": "geoCentroid(null, datum)",
          "as": "centroid"
        },
        {
          "type": "formula",
          "expr": "datum.centroid[0]",
          "as": "longitude"
        },
        {
          "type": "formula",
          "expr": "datum.centroid[1]",
          "as": "latitude"
        },
        {
          "type": "geopoint",
          "projection": "aus_projection",
          "fields": ["longitude", "latitude"],
          "as": ["x", "y"]
        }
      ]
    }
  ],

  "projections": [
    {
      "name": "aus_projection",
      "type": "mercator",
      "fit": {
        "signal": "data('boundaries')"
      },
      "size": [
        {"signal": "width"},
        {"signal": "height"}
      ]
    }
  ],

  "scales": [
    {
      "name": "bubble_size",
      "type": "sqrt",
      "domain": {
        "data": "state_totals",
        "field": "participants_total"
      },
      "range": [150, 3500],
      "zero": true
    }
  ],

  "legends": [
    {
      "size": "bubble_size",
      "title": "NDIS Participants",
      "orient": "bottom",
      "direction": "horizontal",
      "symbolFillColor": "#3182bd",
      "symbolStrokeColor": "#08519c",
      "symbolOpacity": 0.7,
      "format": ",.0s",
      "titleFontSize": 13,
      "labelFontSize": 11,
      "columns": 3
    }
  ],

  "marks": [
    {
      "type": "shape",
      "from": {
        "data": "boundaries"
      },
      "transform": [
        {
          "type": "geoshape",
          "projection": "aus_projection"
        }
      ],
      "encode": {
        "update": {
          "fill": {
            "value": "#e8eef4"
          },
          "stroke": {
            "value": "#ffffff"
          },
          "strokeWidth": {
            "value": 1.5
          }
        }
      }
    },
    {
      "type": "symbol",
      "from": {
        "data": "symbols"
      },
      "encode": {
        "update": {
          "x": {
            "field": "x"
          },
          "y": {
            "field": "y"
          },
          "size": {
            "scale": "bubble_size",
            "field": "participants_total"
          },
          "shape": {
            "value": "circle"
          },
          "fill": {
            "value": "#3182bd"
          },
          "fillOpacity": {
            "value": 0.7
          },
          "stroke": {
            "value": "#08519c"
          },
          "strokeWidth": {
            "value": 1
          },
          "tooltip": {
            "signal": "{'State': datum.state, 'NDIS Participants': format(datum.participants_total, ',.0f')}"
          }
        },
        "hover": {
          "fillOpacity": {
            "value": 1
          }
        }
      }
    }
  ]
}

