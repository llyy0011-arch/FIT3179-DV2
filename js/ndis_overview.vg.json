
{
  "$schema": "https://vega.github.io/schema/vega/v5.json",
  "description": "NDIS participants by state and territory, December 2022",
  "width": 440,
  "height": 340,
  "padding": 10,
  "autosize": "pad",
  "background": "white",

  "title": {
    "text": "NDIS Participation Across Australia",
    "subtitle": "Published participant counts, December 2022",
    "anchor": "middle",
    "fontSize": 15,
    "subtitleFontSize": 10,
    "offset": 12
  },

  "data": [
    {
      "name": "state_totals",
      "url": "Data/ndis_2026_clean.csv",
      "format": {
        "type": "csv",
        "parse": {
          "report_date": "string",
          "state": "string",
          "participants": "string"
        }
      },
      "transform": [
        {
          "type": "filter",
          "expr": "datum.report_date === '2022-12-31'"
        },
        {
          "type": "filter",
          "expr": "indexof(['NSW','VIC','QLD','SA','WA','TAS','NT','ACT','New South Wales','Victoria','Queensland','South Australia','Western Australia','Tasmania','Northern Territory','Australian Capital Territory'], datum.state) >= 0"
        },
        {
          "type": "filter",
          "expr": "datum.participants != null && datum.participants !== '' && datum.participants !== '<11'"
        },
        {
          "type": "formula",
          "expr": "toNumber(datum.participants)",
          "as": "count"
        },
        {
          "type": "filter",
          "expr": "isValid(datum.count) && isFinite(datum.count) && datum.count >= 0"
        },
        {
          "type": "formula",
          "expr": "datum.state === 'NSW' ? 'New South Wales' : datum.state === 'VIC' ? 'Victoria' : datum.state === 'QLD' ? 'Queensland' : datum.state === 'SA' ? 'South Australia' : datum.state === 'WA' ? 'Western Australia' : datum.state === 'TAS' ? 'Tasmania' : datum.state === 'NT' ? 'Northern Territory' : datum.state === 'ACT' ? 'Australian Capital Territory' : datum.state",
          "as": "state_full"
        },
        {
          "type": "aggregate",
          "groupby": ["state_full"],
          "fields": ["count"],
          "ops": ["sum"],
          "as": ["participants_total"]
        },
        {
          "type": "formula",
          "expr": "datum.state_full",
          "as": "state"
        }
      ]
    },

    {
      "name": "boundaries",
      "url": "Data/state_2021.json",
      "format": {
        "type": "topojson",
        "feature": "LGA_2021_AUST_GDA94"
      },
      "transform": [
        {
          "type": "formula",
          "expr": "datum.properties.STE_NAME21",
          "as": "state"
        }
      ]
    },

    {
      "name": "symbols",
      "values": [
        {
          "state": "New South Wales",
          "longitude": 147.0,
          "latitude": -32.2
        },
        {
          "state": "Victoria",
          "longitude": 143.5,
          "latitude": -37.5
        },
        {
          "state": "Queensland",
          "longitude": 145.0,
          "latitude": -22.5
        },
        {
          "state": "South Australia",
          "longitude": 135.8,
          "latitude": -30.0
        },
        {
          "state": "Western Australia",
          "longitude": 121.0,
          "latitude": -26.0
        },
        {
          "state": "Tasmania",
          "longitude": 146.5,
          "latitude": -42.1
        },
        {
          "state": "Northern Territory",
          "longitude": 133.5,
          "latitude": -19.5
        },
        {
          "state": "Australian Capital Territory",
          "longitude": 150.0,
          "latitude": -35.5
        }
      ],
      "transform": [
        {
          "type": "lookup",
          "from": "state_totals",
          "key": "state",
          "fields": ["state"],
          "values": ["participants_total"],
          "as": ["participants_total"]
        },
        {
          "type": "filter",
          "expr": "isValid(datum.participants_total) && datum.participants_total > 0"
        },
        {
          "type": "geopoint",
          "projection": "aus_projection",
          "fields": ["longitude", "latitude"],
          "as": ["x", "y"]
        },
        {
          "type": "formula",
          "expr": "{'State': datum.state, 'Published NDIS participants': format(datum.participants_total, ',.0f')}",
          "as": "tooltip_text"
        }
      ]
    }
  ],

  "projections": [
    {
      "name": "aus_projection",
      "type": "mercator",
      "fit": {
        "signal": "data('boundaries')"
      },
      "size": [
        {
          "signal": "width"
        },
        {
          "signal": "height"
        }
      ]
    }
  ],

  "scales": [
    {
      "name": "bubble_size",
      "type": "sqrt",
      "domain": {
        "data": "state_totals",
        "field": "participants_total"
      },
      "range": [35, 850],
      "zero": true
    }
  ],

  "legends": [
    {
      "size": "bubble_size",
      "title": "NDIS Participants",
      "orient": "bottom",
      "direction": "horizontal",
      "symbolFillColor": "#3182bd",
      "symbolStrokeColor": "#08519c",
      "symbolOpacity": 0.7,
      "format": ",.0s",
      "titleFontSize": 11,
      "labelFontSize": 10,
      "columns": 3,
      "offset": 12
    }
  ],

  "marks": [
    {
      "type": "shape",
      "name": "australia_map",
      "from": {
        "data": "boundaries"
      },
      "interactive": false,
      "transform": [
        {
          "type": "geoshape",
          "projection": "aus_projection"
        }
      ],
      "encode": {
        "update": {
          "fill": {
            "value": "#e8eef4"
          },
          "stroke": {
            "value": "#ffffff"
          },
          "strokeWidth": {
            "value": 0.7
          }
        }
      }
    },

    {
      "type": "symbol",
      "name": "ndis_bubbles",
      "from": {
        "data": "symbols"
      },
      "interactive": true,
      "encode": {
        "enter": {
          "shape": {
            "value": "circle"
          },
          "cursor": {
            "value": "pointer"
          }
        },
        "update": {
          "x": {
            "field": "x"
          },
          "y": {
            "field": "y"
          },
          "size": {
            "scale": "bubble_size",
            "field": "participants_total"
          },
          "fill": {
            "value": "#3182bd"
          },
          "fillOpacity": {
            "value": 0.7
          },
          "stroke": {
            "value": "#08519c"
          },
          "strokeWidth": {
            "value": 1
          },
          "tooltip": {
            "field": "tooltip_text"
          }
        },
        "hover": {
          "fillOpacity": {
            "value": 1
          },
          "strokeWidth": {
            "value": 2
          }
        }
      }
    },

    {
      "type": "symbol",
      "name": "hover_targets",
      "from": {
        "data": "symbols"
      },
      "interactive": true,
      "encode": {
        "enter": {
          "shape": {
            "value": "circle"
          },
          "cursor": {
            "value": "pointer"
          }
        },
        "update": {
          "x": {
            "field": "x"
          },
          "y": {
            "field": "y"
          },
          "size": {
            "signal": "max(450, scale('bubble_size', datum.participants_total))"
          },
          "fill": {
            "value": "#3182bd"
          },
          "fillOpacity": {
            "value": 0
          },
          "strokeOpacity": {
            "value": 0
          },
          "tooltip": {
            "field": "tooltip_text"
          }
        }
      }
    }
  ]
}
