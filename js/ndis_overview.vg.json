
{
  "$schema": "https://vega.github.io/schema/vega/v5.json",
  "description": "Top 20 LGAs by NDIS participants in December 2022.",
  "width": 600,
  "height": 410,
  "padding": {
    "top": 15,
    "bottom": 20,
    "left": 15,
    "right": 15
  },
  "autosize": "pad",
  "background": "white",

  "signals": [
    {
      "name": "selectedState",
      "value": "All",
      "bind": {
        "input": "select",
        "name": "State: ",
        "options": [
          "All",
          "NSW",
          "VIC",
          "QLD",
          "SA",
          "WA",
          "TAS",
          "NT",
          "ACT"
        ]
      }
    },
    {
      "name": "zoom",
      "value": 1,
      "bind": {
        "input": "range",
        "name": "Zoom: ",
        "min": 1,
        "max": 5,
        "step": 0.1
      }
    },
    {
      "name": "mapCenter",
      "update": "selectedState === 'NSW' ? [147,-32] : selectedState === 'VIC' ? [145,-37] : selectedState === 'QLD' ? [145,-22] : selectedState === 'SA' ? [135,-30] : selectedState === 'WA' ? [122,-26] : selectedState === 'TAS' ? [146.5,-42] : selectedState === 'NT' ? [133,-20] : selectedState === 'ACT' ? [149.1,-35.3] : [133.5,-27]"
    },
    {
      "name": "baseScale",
      "update": "selectedState === 'All' ? 600 : selectedState === 'ACT' ? 30000 : selectedState === 'VIC' ? 2700 : selectedState === 'TAS' ? 4300 : selectedState === 'NSW' ? 1300 : selectedState === 'QLD' ? 1150 : selectedState === 'SA' ? 1700 : selectedState === 'WA' ? 1150 : 1800"
    }
  ],

  "data": [
    {
      "name": "metrics",
      "url": "Data/ndis_lga_bivariate.csv",
      "format": {
        "type": "csv",
        "parse": {
          "lga_code": "string",
          "participants_2022": "number",
          "participants_2025": "number",
          "pct_change": "number",
          "longitude": "number",
          "latitude": "number"
        }
      },
      "transform": [
        {
          "type": "formula",
          "as": "lga_code",
          "expr": "toString(datum.lga_code)"
        }
      ]
    },
    {
      "name": "areas",
      "url": "Data/lga_2021.json",
      "format": {
        "type": "topojson",
        "feature": "LGA_2021_AUST_GDA94"
      },
      "transform": [
        {
          "type": "formula",
          "as": "lga_code",
          "expr": "toString(datum.properties.LGA_CODE21)"
        },
        {
          "type": "lookup",
          "from": "metrics",
          "key": "lga_code",
          "fields": ["lga_code"],
          "values": [
            "lga",
            "state",
            "participants_2022"
          ],
          "as": [
            "lga",
            "state",
            "participants_2022"
          ]
        },
        {
          "type": "filter",
          "expr": "selectedState === 'All' || datum.state === selectedState || datum.properties.STE_NAME21 === ({'NSW':'New South Wales','VIC':'Victoria','QLD':'Queensland','SA':'South Australia','WA':'Western Australia','TAS':'Tasmania','NT':'Northern Territory','ACT':'Australian Capital Territory'}[selectedState])"
        }
      ]
    },
    {
      "name": "rankedPoints",
      "source": "metrics",
      "transform": [
        {
          "type": "filter",
          "expr": "isValid(datum.participants_2022) && datum.participants_2022 > 0 && isValid(datum.longitude) && isValid(datum.latitude) && (selectedState === 'All' || datum.state === selectedState)"
        },
        {
          "type": "geopoint",
          "projection": "aus",
          "fields": ["longitude", "latitude"],
          "as": ["x", "y"]
        },
        {
          "type": "filter",
          "expr": "isValid(datum.x) && isValid(datum.y)"
        }
      ]
    }
  ],

  "projections": [
    {
      "name": "aus",
      "type": "mercator",
      "center": {"signal": "mapCenter"},
      "scale": {"signal": "baseScale * zoom"},
      "translate": [
        {"signal": "width / 2"},
        {"signal": "height / 2"}
      ]
    }
  ],

  "scales": [
    {
      "name": "bubble",
      "type": "linear",
      "domain": {
        "data": "rankedPoints",
        "field": "participants_2022"
      },
      "domainMin": 0,
      "range": [8, 650],
      "zero": true
    }
  ],

  "marks": [
    {
      "type": "shape",
      "from": {"data": "areas"},
      "transform": [
        {
          "type": "geoshape",
          "projection": "aus"
        }
      ],
      "encode": {
        "update": {
          "fill": {"value": "#e5e9ed"},
          "stroke": {"value": "#ffffff"},
          "strokeWidth": {"value": 0.5},
          "tooltip": {
            "signal": "{'LGA': datum.lga || datum.properties.LGA_NAME21, 'State': datum.state || datum.properties.STE_NAME21, 'NDIS participants (2022)': isValid(datum.participants_2022) ? format(datum.participants_2022, ',') : 'Data unavailable'}"
          }
        },
        "hover": {
          "fill": {"value": "#cbd5e1"},
          "stroke": {"value": "#254b70"},
          "strokeWidth": {"value": 1.2}
        }
      }
    },
    {
      "type": "symbol",
      "from": {"data": "rankedPoints"},
      "encode": {
        "update": {
          "x": {"field": "x"},
          "y": {"field": "y"},
          "size": {
            "scale": "bubble",
            "field": "participants_2022"
          },
          "shape": {"value": "circle"},
          "fill": {"value": "#236b8e"},
          "fillOpacity": {"value": 0.55},
          "stroke": {"value": "#164665"},
          "strokeWidth": {"value": 0.8},
          "tooltip": {
            "signal": "{'Rank': datum.rank, 'LGA': datum.lga, 'State': datum.state, 'NDIS participants (2022)': format(datum.participants_2022, ',')}"
          }
        },
        "hover": {
          "fill": {"value": "#104c74"},
          "fillOpacity": {"value": 0.85},
          "strokeWidth": {"value": 1.5}
        }
      }
    }
  ],

  "legends": [
    {
      "size": "bubble",
      "orient": "bottom",
      "title": "NDIS participants",
      "format": ",.0f",
      "symbolFillColor": "#236b8e",
      "symbolFillOpacity": 0.55,
      "symbolStrokeColor": "#164665",
      "symbolCount": 4
    }
  ],

  "config": {
    "legend": {
      "labelFont": "Arial",
      "titleFont": "Arial",
      "labelFontSize": 11,
      "titleFontSize": 12,
      "padding": 10
    }
  }
}



