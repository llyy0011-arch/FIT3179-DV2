
{
  "$schema": "https://vega.github.io/schema/vega/v5.json",
  "description": "Share of published NDIS participants across Australia's eight states and territories, December 2022",
  "width": 440,
  "height": 340,
  "padding": 10,
  "autosize": "pad",
  "background": "white",

  "title": {
    "text": "Share of NDIS Participants by State",
    "subtitle": "Share across eight states and territories, December 2022",
    "anchor": "middle",
    "fontSize": 15,
    "subtitleFontSize": 10,
    "offset": 12
  },

  "data": [
    {
      "name": "state_totals",
      "url": "Data/ndis_2026_clean.csv",
      "format": {
        "type": "csv",
        "parse": {
          "report_date": "string",
          "state": "string",
          "participants": "string"
        }
      },
      "transform": [
        {
          "type": "filter",
          "expr": "datum.report_date === '2022-12-31'"
        },
        {
          "type": "filter",
          "expr": "indexof(['New South Wales', 'Victoria', 'Queensland', 'South Australia', 'Western Australia', 'Tasmania', 'Northern Territory', 'Australian Capital Territory', 'NSW', 'VIC', 'QLD', 'SA', 'WA', 'TAS', 'NT', 'ACT'], datum.state) >= 0"
        },
        {
          "type": "filter",
          "expr": "datum.participants != null && datum.participants !== '' && datum.participants !== '<11'"
        },
        {
          "type": "formula",
          "expr": "toNumber(datum.participants)",
          "as": "count"
        },
        {
          "type": "filter",
          "expr": "isValid(datum.count) && isFinite(datum.count) && datum.count >= 0"
        },
        {
          "type": "formula",
          "expr": "datum.state === 'NSW' ? 'New South Wales' : datum.state === 'VIC' ? 'Victoria' : datum.state === 'QLD' ? 'Queensland' : datum.state === 'SA' ? 'South Australia' : datum.state === 'WA' ? 'Western Australia' : datum.state === 'TAS' ? 'Tasmania' : datum.state === 'NT' ? 'Northern Territory' : datum.state === 'ACT' ? 'Australian Capital Territory' : datum.state",
          "as": "state_full"
        },
        {
          "type": "aggregate",
          "groupby": ["state_full"],
          "fields": ["count"],
          "ops": ["sum"],
          "as": ["participants_total"]
        },
        {
          "type": "formula",
          "expr": "datum.state_full",
          "as": "state"
        },
        {
          "type": "joinaggregate",
          "fields": ["participants_total"],
          "ops": ["sum"],
          "as": ["australia_total"]
        },
        {
          "type": "formula",
          "expr": "datum.participants_total / datum.australia_total * 100",
          "as": "percentage"
        }
      ]
    },

    {
      "name": "boundaries",
      "url": "Data/state_2021.json",
      "format": {
        "type": "topojson",
        "feature": "LGA_2021_AUST_GDA94"
      },
      "transform": [
        {
          "type": "formula",
          "expr": "datum.properties.STE_NAME21",
          "as": "state"
        },
        {
          "type": "lookup",
          "from": "state_totals",
          "key": "state",
          "fields": ["state"],
          "values": ["participants_total", "percentage"],
          "as": ["participants_total", "percentage"]
        }
      ]
    }
  ],

  "projections": [
    {
      "name": "aus_projection",
      "type": "mercator",
      "fit": {
        "signal": "data('boundaries')"
      },
      "size": [
        {"signal": "width"},
        {"signal": "height"}
      ]
    }
  ],

  "scales": [
    {
      "name": "colour_scale",
      "type": "linear",
      "domain": {
        "data": "state_totals",
        "field": "percentage"
      },
      "range": ["#deebf7", "#08519c"],
      "zero": true,
      "nice": true
    }
  ],

  "legends": [
    {
      "fill": "colour_scale",
      "title": "Share of participants (%)",
      "orient": "bottom",
      "direction": "horizontal",
      "gradientLength": 230,
      "gradientThickness": 10,
      "format": ".1f",
      "titleFontSize": 11,
      "labelFontSize": 10,
      "offset": 12
    }
  ],

  "marks": [
    {
      "type": "shape",
      "from": {
        "data": "boundaries"
      },
      "transform": [
        {
          "type": "geoshape",
          "projection": "aus_projection"
        }
      ],
      "encode": {
        "update": {
          "fill": [
            {
              "test": "isValid(datum.percentage)",
              "scale": "colour_scale",
              "field": "percentage"
            },
            {
              "value": "#eeeeee"
            }
          ],
          "stroke": {
            "value": "#ffffff"
          },
          "strokeWidth": {
            "value": 1
          },
          "tooltip": {
            "signal": "{'State': datum.state, 'Share of eight-state/territory total': isValid(datum.percentage) ? format(datum.percentage, '.2f') + '%' : 'No data', 'Published participants': isValid(datum.participants_total) ? format(datum.participants_total, ',.0f') : 'No data'}"
          }
        }
      }
    }
  ]
}
