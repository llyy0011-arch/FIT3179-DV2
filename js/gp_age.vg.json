
{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Waiting time and cost as reasons for unmet GP needs across age groups, Australia, 2022.",
  "title": {
    "text": "How Do Waiting Time and Cost Barriers Vary by Age?",
    "subtitle": "Selected main reasons for unmet GP need among people with disability, Australia, 2022 (%)",
    "anchor": "start",
    "font": "Arial",
    "fontSize": 19,
    "subtitleFontSize": 12,
    "subtitleColor": "#64748B",
    "offset": 20
  },
  "data": {
    "url": "Data/GPBarriers.csv",
    "format": {
      "type": "csv",
      "parse": {
        "Percentage": "number"
      }
    }
  },
  "transform": [
    {
      "filter": "datum.Characteristic === 'Age group'"
    },
    {
      "filter": "datum.Reason === 'Waiting time too long / unavailable' || datum.Reason === 'Cost'"
    },
    {
      "filter": "isValid(datum.Percentage)"
    },
    {
      "calculate": "datum.Reason === 'Waiting time too long / unavailable' ? 'Long waiting time' : 'Cost'",
      "as": "ShortReason"
    }
  ],
  "facet": {
    "field": "Population group",
    "type": "ordinal",
    "title": null,
    "sort": [
      "Under 25",
      "25–44",
      "45–64",
      "65 and over"
    ],
    "header": {
      "labelFontSize": 15,
      "labelFontWeight": "bold",
      "labelColor": "#245879",
      "labelPadding": 12
    }
  },
  "columns": 2,
  "spec": {
    "width": 310,
    "height": 135,
    "layer": [
      {
        "mark": {
          "type": "point",
          "filled": true,
          "size": 170,
          "opacity": 0.95
        },
        "encoding": {
          "x": {
            "field": "Percentage",
            "type": "quantitative",
            "title": "Percentage (%)",
            "scale": {
              "domain": [0, 55],
              "zero": true
            },
            "axis": {
              "grid": true,
              "gridColor": "#E8EDF2",
              "tickCount": 6,
              "labelFontSize": 11,
              "titleFontSize": 12
            }
          },
          "y": {
            "field": "ShortReason",
            "type": "nominal",
            "title": null,
            "sort": [
              "Long waiting time",
              "Cost"
            ],
            "axis": {
              "labelFontSize": 12,
              "labelLimit": 150,
              "labelPadding": 10,
              "ticks": false,
              "domain": false
            }
          },
          "color": {
            "field": "ShortReason",
            "type": "nominal",
            "scale": {
              "domain": [
                "Long waiting time",
                "Cost"
              ],
              "range": [
                "#DB7B32",
                "#237BA3"
              ]
            },
            "legend": null
          },
          "tooltip": [
            {
              "field": "Population group",
              "type": "nominal",
              "title": "Age group"
            },
            {
              "field": "Reason",
              "type": "nominal",
              "title": "Reason"
            },
            {
              "field": "Percentage",
              "type": "quantitative",
              "title": "Percentage (%)",
              "format": ".1f"
            },
            {
              "field": "CI",
              "type": "nominal",
              "title": "95% CI"
            }
          ]
        }
      },
      {
        "mark": {
          "type": "text",
          "align": "left",
          "baseline": "middle",
          "dx": 11,
          "fontSize": 12,
          "fontWeight": "bold"
        },
        "encoding": {
          "x": {
            "field": "Percentage",
            "type": "quantitative"
          },
          "y": {
            "field": "ShortReason",
            "type": "nominal",
            "sort": [
              "Long waiting time",
              "Cost"
            ]
          },
          "text": {
            "field": "Percentage",
            "type": "quantitative",
            "format": ".1f"
          },
          "color": {
            "field": "ShortReason",
            "type": "nominal",
            "scale": {
              "domain": [
                "Long waiting time",
                "Cost"
              ],
              "range": [
                "#B85B21",
                "#176489"
              ]
            },
            "legend": null
          }
        }
      }
    ]
  },
  "resolve": {
    "scale": {
      "x": "shared",
      "y": "shared",
      "color": "shared"
    }
  },
  "config": {
    "font": "Arial",
    "view": {
      "stroke": null
    },
    "facet": {
      "spacing": 35
    },
    "axis": {
      "labelColor": "#34495E",
      "titleColor": "#34495E"
    }
  }
}
