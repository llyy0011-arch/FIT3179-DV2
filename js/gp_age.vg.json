
{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Small multiples dot plot of unmet GP care reasons by age group, Australia, 2022.",
  "title": {
    "text": "How Do Barriers to GP Care Differ by Age?",
    "subtitle": "Main reasons for unmet GP need among people with disability, 2022 (%)",
    "anchor": "start",
    "fontSize": 19,
    "subtitleFontSize": 13,
    "offset": 20
  },
  "data": {
    "url": "Data/GPBarriers.csv",
    "format": {
      "type": "csv",
      "parse": {
        "Percentage": "number"
      }
    }
  },
  "transform": [
    {
      "filter": "datum.Characteristic === 'Age group'"
    },
    {
      "filter": "datum.Reason !== 'Total' && isValid(datum.Percentage)"
    },
    {
      "calculate": "datum.Reason === 'Waiting time too long / unavailable' ? 'Waiting time' : datum.Reason === 'Transport or distance / physical access / language' ? 'Transport / access' : datum.Reason === 'Other (incl. upcoming appointment)' ? 'Other reasons' : datum.Reason",
      "as": "ShortReason"
    }
  ],
  "facet": {
    "field": "Population group",
    "type": "ordinal",
    "title": null,
    "sort": [
      "Under 25",
      "25–44",
      "45–64",
      "65 and over"
    ],
    "header": {
      "labelFontSize": 15,
      "labelFontWeight": "bold",
      "labelColor": "#245879",
      "labelPadding": 12
    }
  },
  "columns": 2,
  "spec": {
    "width": 310,
    "height": 220,
    "mark": {
      "type": "point",
      "filled": true,
      "size": 140,
      "color": "#237BA3",
      "opacity": 0.9
    },
    "encoding": {
      "x": {
        "field": "Percentage",
        "type": "quantitative",
        "title": "Percentage (%)",
        "scale": {
          "domain": [0, 55],
          "zero": true
        },
        "axis": {
          "grid": true,
          "tickCount": 6,
          "labelFontSize": 11,
          "titleFontSize": 12
        }
      },
      "y": {
        "field": "ShortReason",
        "type": "nominal",
        "title": null,
        "sort": [
          "Waiting time",
          "Other reasons",
          "Too busy",
          "Cost",
          "Dislike or fear",
          "Transport / access"
        ],
        "axis": {
          "labelFontSize": 11,
          "labelLimit": 145,
          "labelPadding": 8
        }
      },
      "tooltip": [
        {
          "field": "Population group",
          "type": "nominal",
          "title": "Age group"
        },
        {
          "field": "Reason",
          "type": "nominal",
          "title": "Reason"
        },
        {
          "field": "Percentage",
          "type": "quantitative",
          "title": "Percentage (%)",
          "format": ".1f"
        },
        {
          "field": "CI",
          "type": "nominal",
          "title": "95% CI"
        }
      ]
    }
  },
  "resolve": {
    "scale": {
      "x": "shared",
      "y": "shared"
    }
  },
  "config": {
    "font": "Arial",
    "view": {
      "stroke": null
    },
    "facet": {
      "spacing": 30
    },
    "axis": {
      "labelColor": "#34495E",
      "titleColor": "#34495E"
    }
  }
}
