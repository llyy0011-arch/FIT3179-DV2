
{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Main reasons for unmet GP needs among people with disability in Australia, 2022.",
  "title": {
    "text": "Waiting Time Is the Leading Barrier to GP Care",
    "subtitle": [
      "Main reason for unmet GP need among people with disability, Australia, 2022 (%)",
      "Select a disability group to explore differences in reported barriers."
    ],
    "anchor": "start",
    "font": "Arial",
    "fontSize": 19,
    "fontWeight": "bold",
    "subtitleFont": "Arial",
    "subtitleFontSize": 12,
    "subtitleColor": "#64748B",
    "offset": 22
  },
  "data": {
    "url": "Data/GPBarriers.csv",
    "format": {
      "type": "csv",
      "parse": {
        "Percentage": "number"
      }
    }
  },
  "width": 690,
  "height": 345,
  "autosize": {
    "type": "pad",
    "contains": "padding"
  },
  "padding": {
    "left": 15,
    "right": 70,
    "top": 20,
    "bottom": 20
  },
  "params": [
    {
      "name": "selectedGroup",
      "value": "All persons",
      "bind": {
        "input": "select",
        "name": "Disability group: ",
        "options": [
          "All persons",
          "Severe or profound disability(a)",
          "Other disability status(b)",
          "Sensory or speech",
          "Learning and understanding",
          "Physical",
          "Psychosocial"
        ],
        "labels": [
          "All persons",
          "Severe or profound disability",
          "Other disability status",
          "Sensory or speech",
          "Learning and understanding",
          "Physical",
          "Psychosocial"
        ]
      }
    }
  ],
  "transform": [
    {
      "filter": "datum['Population group'] === selectedGroup"
    },
    {
      "filter": "datum.Reason !== 'Total' && isValid(datum.Percentage)"
    },
    {
      "calculate": "datum.Reason === 'Waiting time too long / unavailable' ? 'Long waiting time' : datum.Reason === 'Transport or distance / physical access / language' || datum.Reason === 'transport or distance / physical access / language' ? 'Transport / access' : datum.Reason === 'Other (incl. upcoming appointment)' ? 'Other reasons' : datum.Reason",
      "as": "ShortReason"
    },
    {
      "calculate": "datum.ShortReason === 'Long waiting time' ? 1 : datum.ShortReason === 'Other reasons' ? 2 : datum.ShortReason === 'Too busy' ? 3 : datum.ShortReason === 'Cost' ? 4 : datum.ShortReason === 'Dislike or fear' ? 5 : 6",
      "as": "ReasonOrder"
    },
    {
      "calculate": "datum.ShortReason === 'Long waiting time'",
      "as": "IsLeadingBarrier"
    }
  ],
  "encoding": {
    "y": {
      "field": "ShortReason",
      "type": "nominal",
      "title": null,
      "sort": {
        "field": "ReasonOrder",
        "order": "ascending"
      },
      "axis": {
        "labelFontSize": 12,
        "labelLimit": 200,
        "labelPadding": 12,
        "ticks": false,
        "domain": false
      }
    },
    "x": {
      "field": "Percentage",
      "type": "quantitative",
      "title": "Percentage (%)",
      "scale": {
        "domain": [0, 60]
      },
      "axis": {
        "grid": true,
        "gridColor": "#E8EDF2",
        "gridWidth": 1,
        "labelFontSize": 11,
        "titleFontSize": 12,
        "titlePadding": 12,
        "tickCount": 7,
        "domain": false
      }
    },
    "tooltip": [
      {
        "field": "Population group",
        "type": "nominal",
        "title": "Disability group"
      },
      {
        "field": "Reason",
        "type": "nominal",
        "title": "Reason"
      },
      {
        "field": "Percentage",
        "type": "quantitative",
        "title": "Percentage (%)",
        "format": ".1f"
      },
      {
        "field": "CI",
        "type": "nominal",
        "title": "95% CI"
      }
    ]
  },
  "layer": [
    {
      "mark": {
        "type": "rule",
        "strokeWidth": 3,
        "opacity": 0.75
      },
      "encoding": {
        "x": {
          "datum": 0
        },
        "x2": {
          "field": "Percentage"
        },
        "color": {
          "condition": {
            "test": "datum.IsLeadingBarrier",
            "value": "#E69A55"
          },
          "value": "#A9C2D1"
        }
      }
    },
    {
      "mark": {
        "type": "point",
        "filled": true,
        "size": 145,
        "stroke": "white",
        "strokeWidth": 1.2
      },
      "encoding": {
        "color": {
          "condition": {
            "test": "datum.IsLeadingBarrier",
            "value": "#DB7B32"
          },
          "value": "#4F91B2"
        }
      }
    },
    {
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "middle",
        "dx": 12,
        "fontSize": 12
      },
      "encoding": {
        "text": {
          "field": "Percentage",
          "type": "quantitative",
          "format": ".1f"
        },
        "color": {
          "condition": {
            "test": "datum.IsLeadingBarrier",
            "value": "#B85B21"
          },
          "value": "#34495E"
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.IsLeadingBarrier"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "bottom",
        "dx": 12,
        "dy": -13,
        "fontSize": 11,
        "fontWeight": "bold",
        "color": "#B85B21"
      },
      "encoding": {
        "text": {
          "value": "Most reported barrier"
        }
      }
    }
  ],
  "config": {
    "view": {
      "stroke": null
    },
    "font": "Arial",
    "axis": {
      "labelColor": "#34495E",
      "titleColor": "#34495E"
    }
  }
}
